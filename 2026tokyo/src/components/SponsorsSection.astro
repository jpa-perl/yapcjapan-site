---
import type { ImageMetadata } from "astro";
import SectionHeading from "./SectionHeading.astro";
import { externalLinkProps } from "../utils/links";

interface Sponsor {
  name: string;
  url: string;
  logo: ImageMetadata;
}

interface SponsorPlan {
  id: string;
  name: string;
  sponsors: readonly Sponsor[];
}

interface Props {
  plans: readonly SponsorPlan[];
}

const { plans } = Astro.props;
---

<section id="sponsors" class="scroll-mt-24 lg:scroll-mt-28">
  <div
    class="py-12 max-w-page mx-auto px-4 flex flex-col items-center gap-10 sm:px-5 sm:py-16 sm:gap-12"
  >
    <SectionHeading title="Sponsors" subtitle="スポンサー" />

    <div class="sponsor-plans">
      {
        plans.map((plan) => (
          <section
            class="sponsor-plan"
            data-plan={plan.id}
            aria-labelledby={`sponsor-plan-${plan.id}`}
          >
            <h3
              id={`sponsor-plan-${plan.id}`}
              class="font-solway text-xl font-bold leading-tight text-ink sm:text-2xl"
            >
              {plan.name}
            </h3>

            <ul class="sponsor-logos">
              {plan.sponsors.map((sponsor) => (
                <li>
                  <a
                    href={sponsor.url}
                    {...externalLinkProps(sponsor.url)}
                    class="sponsor-logo rounded-lg focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-orange"
                  >
                    <img
                      src={sponsor.logo.src}
                      width={sponsor.logo.width}
                      height={sponsor.logo.height}
                      alt={sponsor.name}
                      class="block size-full object-contain"
                      loading="lazy"
                      decoding="async"
                    />
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </div>
</section>

<style>
  .sponsor-plans {
    display: flex;
    width: 100%;
    max-width: 100rem;
    flex-direction: column;
    align-items: center;
    gap: 3rem;
  }

  .sponsor-plan {
    --logo-size: clamp(3.5rem, 18vw, 5rem);
    --logo-gap: 0.75rem;
    display: flex;
    width: 100%;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  .sponsor-plan[data-plan="perl-sponsor"] {
    --logo-size: clamp(7rem, 36vw, 10rem);
  }

  .sponsor-plan[data-plan="platinum-sponsor"] {
    --logo-size: clamp(5.5rem, 27vw, 8rem);
  }

  .sponsor-plan[data-plan="gold-sponsor"] {
    --logo-size: clamp(4.75rem, 24vw, 6.75rem);
  }

  .sponsor-plan[data-plan="silver-sponsor"] {
    --logo-size: clamp(4rem, 21vw, 5.75rem);
  }

  .sponsor-logos {
    /* 折り返しは画面幅まかせにする。1 行に入る数が幅に応じて変わり、
       余った最終行も justify-content で中央に寄る。ロゴ同士の間隔は
       過去サイト（2024hakodate の gap-5、2025fukuoka のセル padding 10px）と
       同じく --logo-gap ぴったりになる。 */
    display: flex;
    max-width: 100%;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: var(--logo-gap);
  }

  .sponsor-logos li {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
  }

  .sponsor-logo {
    display: block;
    position: relative;
    /* 入稿用の正方形キャンバスを同じ寸法で表示し、画像内の余白も尊重する。 */
    width: var(--logo-size);
    min-width: 2.75rem;
    max-width: 100%;
    aspect-ratio: 1;
    /* 透過ロゴと白背景ロゴが混在するので、下地を白で揃える。 */
    background-color: var(--color-white);
    padding: 0.25rem;
    transition: opacity 180ms ease;
  }

  /* 画像の直角の角が角丸の外に出るため、画像側にも同じ角丸を与える。
     外側を overflow で切ると、枠の外に描いている縫い目まで消える。 */
  .sponsor-logo img {
    border-radius: inherit;
  }

  /* スピーカー写真の縫い目（#a7a7a7・線幅 1.5px・外側 5px）と同じ扱いにして、
     ロゴもキルトに縫い付けられた一片として見せる。CSS の dashed では破線が
     細かくなりすぎるため、global.css の patchwork-card と同じ SVG 方式で
     目のピッチを揃える。 */
  .sponsor-logo::after {
    background: url("data:image/svg+xml,%3Csvg viewBox='0 0 100 100' preserveAspectRatio='none' xmlns='http://www.w3.org/2000/svg'%3E%3Crect x='0.75' y='0.75' width='98.5' height='98.5' rx='5' ry='5' fill='none' stroke='%23a7a7a7' stroke-width='1.5' stroke-linecap='round' stroke-dasharray='6 6' vector-effect='non-scaling-stroke'/%3E%3C/svg%3E")
      center / 100% 100% no-repeat;
    content: "";
    inset: -5px;
    pointer-events: none;
    position: absolute;
  }

  @media (hover: hover) {
    .sponsor-logo:hover {
      opacity: 0.7;
    }
  }

  @media (min-width: 40rem) {
    .sponsor-plan {
      --logo-gap: 1.25rem;
    }
  }

  @media (min-width: 64rem) {
    .sponsor-plans {
      gap: 3.5rem;
    }

    .sponsor-plan {
      --logo-size: 6rem;
      gap: 1.75rem;
    }

    .sponsor-logo {
      padding: 0.5rem;
    }

    .sponsor-plan[data-plan="perl-sponsor"] {
      --logo-size: 12rem;
    }

    .sponsor-plan[data-plan="platinum-sponsor"] {
      --logo-size: 10rem;
    }

    .sponsor-plan[data-plan="gold-sponsor"] {
      --logo-size: 8.25rem;
    }

    .sponsor-plan[data-plan="silver-sponsor"] {
      --logo-size: 7rem;
    }
  }

  /* 1280px 以上はロゴを一段大きくする。1 行に入る数が増えるぶん 1 枚は
     控えめにして、プランごとの大小は保つ。 */
  @media (min-width: 80rem) {
    .sponsor-plan {
      --logo-size: 8rem;
      --logo-gap: 1.5rem;
    }

    .sponsor-plan[data-plan="perl-sponsor"] {
      --logo-size: 18rem;
    }

    .sponsor-plan[data-plan="platinum-sponsor"] {
      --logo-size: 13rem;
    }

    .sponsor-plan[data-plan="gold-sponsor"] {
      --logo-size: 10.5rem;
    }

    .sponsor-plan[data-plan="silver-sponsor"] {
      --logo-size: 9.5rem;
    }
  }

  @media (min-width: 96rem) {
    .sponsor-plan {
      --logo-size: 10rem;
      --logo-gap: 1.75rem;
    }

    .sponsor-plan[data-plan="perl-sponsor"] {
      --logo-size: 21.5rem;
    }

    .sponsor-plan[data-plan="platinum-sponsor"] {
      --logo-size: 16rem;
    }

    .sponsor-plan[data-plan="gold-sponsor"] {
      --logo-size: 14rem;
    }

    .sponsor-plan[data-plan="silver-sponsor"] {
      --logo-size: 13rem;
    }
  }

  @media (min-width: 120rem) {
    .sponsor-plan {
      --logo-size: 10.5rem;
      --logo-gap: 2rem;
    }

    .sponsor-plan[data-plan="perl-sponsor"] {
      --logo-size: 23rem;
    }

    .sponsor-plan[data-plan="platinum-sponsor"] {
      --logo-size: 17rem;
    }

    .sponsor-plan[data-plan="gold-sponsor"] {
      --logo-size: 15rem;
    }

    .sponsor-plan[data-plan="silver-sponsor"] {
      --logo-size: 14rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sponsor-logo {
      transition: none;
    }
  }
</style>

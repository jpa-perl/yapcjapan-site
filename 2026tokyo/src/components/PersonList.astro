---
import type { ImageMetadata } from "astro";
import { externalLinkProps } from "../utils/links";

interface Person {
  name: string;
  // リンク先のない方は持たない。その場合はアイコンと名前をリンクにしない。
  url?: string;
  // アイコンのない方は持たない。その場合は下地の丸だけを出す。
  icon?: ImageMetadata;
}

interface Props {
  people: readonly Person[];
}

const { people } = Astro.props;
---

<ul class="flex w-full max-w-[100rem] flex-wrap justify-center gap-x-4 gap-y-6 sm:gap-x-6 sm:gap-y-8">
  {
    people.map((person) => {
      const Card = person.url ? "a" : "div";
      const linkProps = person.url
        ? { href: person.url, ...externalLinkProps(person.url) }
        : {};

      return (
        <li class="w-24 sm:w-28">
          <Card
            {...linkProps}
            class="person-card flex flex-col items-center gap-2 rounded-lg focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-orange"
          >
            <div class="person-icon-frame w-20 sm:w-24">
              <div class="person-icon-mask relative size-full bg-gray-200">
                {person.icon && (
                  // 名前をすぐ下に出しているので、読み上げが重ならないよう alt は空にする。
                  <img
                    src={person.icon.src}
                    width={person.icon.width}
                    height={person.icon.height}
                    alt=""
                    class="absolute inset-0 size-full object-cover"
                    loading="lazy"
                    decoding="async"
                  />
                )}
              </div>
            </div>
            <span class="font-maru text-sm font-bold leading-snug text-ink text-center wrap-anywhere">
              {person.name}
            </span>
          </Card>
        </li>
      );
    })
  }
</ul>

<style>
  .person-icon-frame {
    aspect-ratio: 260 / 254.196;
    --person-icon-mask: url("data:image/svg+xml,%3Csvg width='260' height='254.196' viewBox='0 0 260 254.196' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M259.475 127.357C265.176 190.338 224.59 242.734 129.748 253.319C34.9047 263.905 1.11012 176.048 0.0200381 127.357C-1.07004 78.6653 42.9497 19.918 105.341 2.45246C167.732 -15.013 253.774 64.3754 259.475 127.357Z' fill='white'/%3E%3C/svg%3E");
    --person-icon-stitch: url("data:image/svg+xml,%3Csvg viewBox='-2 -2 264 258.196' preserveAspectRatio='none' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M259.475 127.357C265.176 190.338 224.59 242.734 129.748 253.319C34.9047 263.905 1.11012 176.048 0.0200381 127.357C-1.07004 78.6653 42.9497 19.918 105.341 2.45246C167.732 -15.013 253.774 64.3754 259.475 127.357Z' fill='none' stroke='%23A7A7A7' stroke-width='1.5' stroke-linecap='round' stroke-dasharray='6 6' vector-effect='non-scaling-stroke'/%3E%3C/svg%3E");
    position: relative;
  }

  .person-icon-frame::after {
    background: var(--person-icon-stitch) center / 100% 100% no-repeat;
    content: "";
    inset: -5px;
    pointer-events: none;
    position: absolute;
  }

  .person-icon-mask {
    mask: var(--person-icon-mask) center / 100% 100% no-repeat;
    -webkit-mask: var(--person-icon-mask) center / 100% 100% no-repeat;
  }

  .person-card {
    transition: opacity 180ms ease;
  }

  /* リンクのない方は押せるように見せない。 */
  @media (hover: hover) {
    a.person-card:hover {
      opacity: 0.7;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .person-card {
      transition: none;
    }
  }
</style>
